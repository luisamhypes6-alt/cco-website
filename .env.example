# hCaptcha site key used by the "Book a Meeting" human-verification gate.
# Get one at https://dashboard.hcaptcha.com (free): create a site, copy its Site Key.
# Copy this file to `.env`, paste your real key below, then restart `npm start`.
# Leaving this unset falls back to hCaptcha's public TEST key, which shows the
# red "This hCaptcha is for testing only" notice.
REACT_APP_HCAPTCHA_SITE_KEY=
